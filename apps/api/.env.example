# ─────────────────────────────────────────────────────────────
# Mentor Bridge — API configuration
# Copy to apps/api/.env and fill in what you need.
# EVERYTHING IS OPTIONAL for local development: with no .env the API
# starts an embedded MongoDB and seeds demo data automatically.
# ─────────────────────────────────────────────────────────────

# --- Core
PORT=4000
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# REQUIRED in production: 32+ random characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=
JWT_TTL=7d
COOKIE_SECURE=false

# --- Database
# Leave empty to use the embedded MongoDB (data stored in %LOCALAPPDATA%\alumni-mentor-network).
# Docker:  mongodb://localhost:27017/amn     Atlas: mongodb+srv://user:pass@cluster/amn
MONGODB_URI=
# Development only: load demo data into an empty database. Never happens in production
# (use `npm run bootstrap -w apps/api -- --admin-email you@college.edu` there instead).
SEED_ON_EMPTY=true
# Hosted demo on purpose-seeded data (made-up people): email is written to the outbox, never sent,
# and production no longer requires SMTP_URL. Never turn this on for real users.
HOSTED_DEMO=false

# --- Account security
# REQUIRED in production: encrypts two-factor keys at rest. Generate with `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=
# Sending mentorship requests / submitting alumni verification waits for a confirmed email (default: on)
REQUIRE_EMAIL_VERIFICATION=true
# Staff (admin, Alumni Relations, Placement) must use two-factor sign-in (default: on in production)
REQUIRE_STAFF_2FA=

# --- Verification document storage
# local = API server disk (development). s3 = private S3-compatible bucket (AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com   AWS: leave empty
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Server-side encryption header: AES256 on AWS (default); leave empty for R2 (it encrypts by itself)
S3_SSE=

# --- Background jobs (expiry sweep, reminders, weekly engagement decay)
# true = run inside the API process. Set false when you deploy `npm run start:worker` separately.
JOBS_IN_PROCESS=true
# Key for POST /api/jobs/:group, which a host scheduler calls to run background jobs on hosts that
# stop the app between requests (e.g. Antideploy). Empty turns the endpoint off. openssl rand -hex 32
CRON_SECRET=

# --- Email. Optional in development (emails are written to apps/api/outbox/*.json).
#     REQUIRED in production: password reset and email confirmation depend on it.
# Gmail example: smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM="Mentor Bridge <no-reply@your-institution.edu>"

# --- SMS via Twilio (optional). Without it, SMS are written to apps/api/outbox/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Google sign-in + Google Calendar (optional). Register BOTH redirect URIs:
#     {PUBLIC_API_URL}/api/auth/google/callback
#     {PUBLIC_API_URL}/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: new student accounts via Google must use one of these domains
GOOGLE_STUDENT_DOMAINS=

# --- Outlook / Microsoft 365 calendar (optional). Redirect URI to register:
#     {PUBLIC_API_URL}/api/calendar/outlook/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# --- Video links: jitsi (no setup) or google_meet (needs Google Calendar connected)
VIDEO_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.jit.si

# --- Paid sessions ---
# test = built-in fake gateway for development (refused in production); razorpay = Razorpay Checkout;
# off = mentor fees are ignored and every session is free (the production default).
PAYMENT_GATEWAY=test
# Razorpay Dashboard → Settings → API Keys (rzp_test_… keys for Razorpay's own test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Settings → Webhooks: URL https://<your API>/api/payments/webhook/razorpay,
# events payment.captured, order.paid, payment.failed, refund.processed. Paste the webhook secret here.
RAZORPAY_WEBHOOK_SECRET=
