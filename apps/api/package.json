{
  "name": "@amn/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/seed/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "bootstrap": "tsx src/seed/bootstrap.ts",
    "start:bootstrap": "node dist/seed/bootstrap.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongodb-memory-server": "10.1.3",
    "mongoose": "8.9.5",
    "multer": "^2.0.2",
    "node-cron": "3.0.3",
    "nodemailer": "6.10.0",
    "qrcode": "^1.5.4",
    "socket.io": "4.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.7",
    "@types/node-cron": "3.0.11",
    "@types/nodemailer": "6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "6.0.2",
    "socket.io-client": "4.8.1",
    "supertest": "^7.1.4",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.24"
    }
  }
}
