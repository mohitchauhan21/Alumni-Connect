# ==============================================================================
# P11 — Mentorship Platform Environment Variables (Example Template)
# Copy this file to:
#   - server/.env for backend configuration
#   - client/.env.local for frontend configuration
# NEVER commit real credentials, production secrets, or private keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (server/.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/p11_mentorship
MONGODB_URI=mongodb://127.0.0.1:27017/p11_mentorship

# Authentication & Session Security (Backend only - NEVER expose to frontend)
JWT_SECRET=your_development_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_NAME=p11_auth_token

# ------------------------------------------------------------------------------
# Frontend Configuration (client/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_NAME="P11 Mentorship Platform"
